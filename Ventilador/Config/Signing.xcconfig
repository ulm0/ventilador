// Default signing for everyone: ad-hoc (no Apple account needed). Enough to build and run the tests.
// Registering the privileged helper on macOS needs a real signature, so to run the app for real create
// Config/Signing.local.xcconfig (git-ignored) with your own identity:
//
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = YOURTEAMID
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
